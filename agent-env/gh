#!/bin/bash
# agent-identity gh shim. agent-env.sh puts it first on PATH in agent shells
# only. When a command targets a repository in your org, it runs the real gh
# with a one-hour bot token for that repository instead of the personal login.
# Other commands use the personal login, as AGENT_IDENTITY_PERSONAL allows.
#
#   AGENT_IDENTITY_AGENT=1            set by agent-env.sh; the shim is inert without it
#   AGENT_IDENTITY_ORG=<org>          the org whose repositories use the bot
#   AGENT_IDENTITY_PERSONAL=read|allow|deny
#                                     what may use the personal login (default read)
#   AGENT_IDENTITY_FALLBACK=personal  a read-only command the bot is not
#                                     permitted may use the personal login;
#                                     writes are always refused (default: refuse)
#   AGENT_IDENTITY_DEBUG=1            say on stderr which identity is used
#
# An inherited GH_TOKEN/GITHUB_TOKEN is ignored for org targets (the bot is
# used) and kept for everything else; AGENT_IDENTITY_RESPECT_GH_TOKEN=1 makes
# the shim step aside whenever one is set.

# The real gh is the first gh on PATH outside this shim's directory. Compare
# resolved paths so a symlinked PATH entry cannot make the shim call itself.
# Depth guard: gh extensions legitimately call gh again, but two shim copies on
# PATH would exec each other forever.
export AGENT_IDENTITY_SHIM_DEPTH=$(( ${AGENT_IDENTITY_SHIM_DEPTH:-0} + 1 ))
[ "$AGENT_IDENTITY_SHIM_DEPTH" -le 4 ] || { echo "agent-identity gh shim: nested too deep; is it on PATH twice?" >&2; exit 127; }
self_dir=$(cd "$(dirname "$0")" && pwd -P)
next=""
# A wrapper that hands off to this shim (for harnesses that reset PATH) names
# the real gh explicitly; otherwise search PATH.
if [ -n "$AGENT_IDENTITY_REAL_GH" ] && [ -x "$AGENT_IDENTITY_REAL_GH" ] \
  && [ "$(cd "$(dirname "$AGENT_IDENTITY_REAL_GH")" 2>/dev/null && pwd -P)" != "$self_dir" ]; then
  next=$AGENT_IDENTITY_REAL_GH
fi
IFS=: read -r -a path_entries <<< "$PATH"
for entry in "${path_entries[@]}"; do
  [ -z "$next" ] || break
  [ -n "$entry" ] && [ -x "$entry/gh" ] || continue
  [ "$(cd "$entry" 2>/dev/null && pwd -P)" = "$self_dir" ] && continue
  next="$entry/gh"
done
[ -n "$next" ] || { echo "agent-identity gh shim: no gh found on PATH" >&2; exit 127; }

[ -n "$AGENT_IDENTITY_AGENT" ] || exec "$next" "$@"

# `agent-identity doctor` checks that gh reaches this shim, directly or via a
# wrapper's handoff, without running anything.
if [ "$AGENT_IDENTITY_PROBE" = 1 ] && [ "$1" = version ]; then
  echo "agent-identity shim reached; real gh: $next"
  exit 0
fi

# A GH_TOKEN/GITHUB_TOKEN inherited from the environment must not let an agent
# act on your org's repositories as someone else: for org targets the shim
# ignores it and uses the bot. Other targets still get it. The shim's own
# token (nested gh calls, e.g. extensions) passes straight through.
inherited_gh_token=""
inherited_github_token=""
if [ -n "$GH_TOKEN$GITHUB_TOKEN" ]; then
  if [ "$AGENT_IDENTITY_SHIM_TOKEN" = 1 ] || [ "$AGENT_IDENTITY_RESPECT_GH_TOKEN" = 1 ]; then
    exec "$next" "$@"
  fi
  inherited_gh_token=$GH_TOKEN
  inherited_github_token=$GITHUB_TOKEN
  unset GH_TOKEN GITHUB_TOKEN
fi

# Run the real gh without the bot: with any inherited token restored.
run_unrouted() {
  [ -n "$inherited_gh_token" ] && export GH_TOKEN=$inherited_gh_token
  [ -n "$inherited_github_token" ] && export GITHUB_TOKEN=$inherited_github_token
  exec "$next" "$@"
}

org=${AGENT_IDENTITY_ORG:-}
if [ -z "$org" ]; then
  session="${XDG_CONFIG_HOME:-$HOME/.config}/agent-identity/session.json"
  [ -f "$session" ] && org=$(jq -r '.org // empty' "$session" 2>/dev/null)
fi
[ -n "$org" ] || run_unrouted "$@"

lower() { printf %s "$1" | tr '[:upper:]' '[:lower:]'; }
org_lc=$(lower "$org")
repo=""

# Parse a repository reference in any form gh or git accepts (owner/name, a
# github.com URL in any letter case, www./api. hosts, git@host:owner/name,
# ssh://, git+https://, -R=value) and print "<kind> <owner>/<name>", where kind
# is "gh" for github.com and "other" for any other host (such as an SSH alias).
repo_ref() {
  local v=${1#=} lc host rest
  lc=$(lower "$v")
  if [[ $lc =~ ^(git\+)?[a-z][a-z0-9+.-]*://([^@/]+@)?([^/:]+)(:[0-9]+)?/ ]]; then
    host=${BASH_REMATCH[3]}; rest=${v:${#BASH_REMATCH[0]}}
  elif [[ $lc =~ ^([^@/:]+@)?([^/:]+): ]]; then
    host=${BASH_REMATCH[2]}; rest=${v:${#BASH_REMATCH[0]}}
  elif [[ $lc =~ ^((www|api)\.)?github\.com/ ]]; then
    host=github.com; rest=${v:${#BASH_REMATCH[0]}}
  else
    host=""; rest=$v
  fi
  local kind=other
  case "$host" in ""|github.com|www.github.com|api.github.com) kind=gh ;; esac
  if [ "$host" = api.github.com ] && [[ $(lower "$rest") == repos/* ]]; then rest=${rest#*/}; fi
  rest=${rest#/}
  local owner=${rest%%/*}
  [ "$owner" != "$rest" ] || return 0
  local name=${rest#*/}
  name=${name%%/*}; name=${name%%[?#]*}; name=${name%.git}
  [[ $owner =~ ^[A-Za-z0-9-]+$ ]] && [[ $name =~ ^[A-Za-z0-9._-]+$ ]] && [ "$name" != . ] && [ "$name" != .. ] || return 0
  printf '%s %s/%s' "$kind" "$owner" "$name"
}

# The repository name when a github.com reference is in the org, else nothing.
from_arg() {
  local ref
  ref=$(repo_ref "$1")
  [ -n "$ref" ] && [ "${ref%% *}" = gh ] || return 0
  ref=${ref#* }
  [ "$(lower "${ref%%/*}")" = "$org_lc" ] && printf %s "${ref#*/}"
}

# An explicit repository argument (-R/--repo): the org repository name, or
# "personal" when it is clearly someone else's. Anything that might be the org
# but cannot be resolved to a github.com repository is refused, never sent
# through the personal login.
explicit_repo() {
  local ref
  ref=$(repo_ref "$1")
  if [ -z "$ref" ]; then
    [[ $(lower "$1") == *"$org_lc"* ]] && refuse "cannot resolve repository '$1'"
    printf personal; return 0
  fi
  local kind=${ref%% *} owner_name=${ref#* }
  if [ "$(lower "${owner_name%%/*}")" = "$org_lc" ]; then
    [ "$kind" = gh ] || refuse "repository '$1' names $org on a host other than github.com"
    printf '%s' "${owner_name#*/}"
  else
    printf personal
  fi
}

# The repository commands act on when they name none, as gh resolves it:
# GH_REPO, else the checkout's remotes (origin first, then the rest, so a fork
# whose upstream is the org counts). Remotes on SSH host aliases count too.
context_repo() {
  if [ -n "${GH_REPO:-}" ]; then
    local ref
    ref=$(repo_ref "$GH_REPO")
    ref=${ref#* }
    [ -n "$ref" ] && [ "$(lower "${ref%%/*}")" = "$org_lc" ] && printf %s "${ref#*/}"
    return 0
  fi
  local remote url ref
  for remote in origin $(git remote 2>/dev/null | grep -vx origin); do
    url=$(git remote get-url "$remote" 2>/dev/null) || continue
    ref=$(repo_ref "$url")
    ref=${ref#* }
    if [ -n "$ref" ] && [ "$(lower "${ref%%/*}")" = "$org_lc" ]; then
      printf %s "${ref#*/}"
      return 0
    fi
  done
}

# Writes never use the personal login: a person is often an org admin, and
# borrowing their login would let an agent do what the bot is denied
# (including re-enabling itself after you lock it out).
ARGS="$*"
refuse() {
  echo "agent-identity: $1; refusing. Run it yourself if it is needed: gh $ARGS" >&2
  exit 1
}

# Commands the shim cannot tie to one of your org's repositories run on the
# personal login, subject to AGENT_IDENTITY_PERSONAL:
#   read (default)   pass through only read-only commands; refuse writes and
#                    `gh auth token` (which would hand the agent your token)
#   allow            pass through, as in a human shell
#   deny             refuse everything that would use the personal login
personal() {
  case "${AGENT_IDENTITY_PERSONAL:-read}" in
    allow) run_unrouted "$@" ;;
    deny) refuse "AGENT_IDENTITY_PERSONAL=deny: agent shells never use the personal login" ;;
  esac
  local readonly_cmd=""
  case "$1" in
    ""|help|version|--version|completion|search|status) readonly_cmd=1 ;;
    api)
      if [[ " $* " == *" graphql "* ]]; then
        # An inline GraphQL query, never a mutation or a query read from a file.
        if [[ " $* " != *mutation* ]] && [[ " $* " != *"=@"* ]] && [[ " $* " != *"--input"* ]]; then
          readonly_cmd=1
        fi
      elif [ "$method" = GET ]; then
        readonly_cmd=1
      fi ;;
    auth) [ "$2" = status ] && readonly_cmd=1 ;;
    *) case "$2" in list|view|status|diff|checks|watch|download|browse|log) readonly_cmd=1 ;; esac ;;
  esac
  [ -n "$readonly_cmd" ] && run_unrouted "$@"
  refuse "AGENT_IDENTITY_PERSONAL=read: only read-only commands may use the personal login"
}

# The HTTP method of a gh api call (gh defaults to POST when fields are sent).
method=GET
for arg in "$@"; do
  case "$arg" in -f|--raw-field|-F|--field|--input|-f?*|-F?*|--raw-field=*|--field=*|--input=*) method=POST ;; esac
done
prev=""
for arg in "$@"; do
  case "$prev" in -X|--method) method=$(printf %s "$arg" | tr '[:lower:]' '[:upper:]') ;; esac
  case "$arg" in
    --method=*) method=$(printf %s "${arg#--method=}" | tr '[:lower:]' '[:upper:]') ;;
    -X?*) method=$(printf %s "${arg#-X}" | tr '[:lower:]' '[:upper:]') ;;
  esac
  prev=$arg
done

# Account-level commands pass through to the personal login.
case "$1" in
  config|extension|alias|search|gist|ssh-key|gpg-key|status|codespace|completion|help|version|--version|"")
    personal "$@" ;;
esac

# `gh auth token` and `gh auth git-credential` hand out the bot token inside a
# checkout of an org repository; other auth commands pass through.
if [ "$1" = "auth" ]; then
  case "$2" in
    token|git-credential) repo=$(context_repo) ;;
  esac
  [ -n "$repo" ] || personal "$@"
  token=$(agent-identity token --repo "$repo" --write) || exit 1
  if [ "$2" = token ]; then printf '%s\n' "$token"; exit 0; fi
  [ "$3" = get ] || exit 0
  host=$(sed -n 's/^host=//p')
  [ "$host" = github.com ] && printf 'protocol=https\nhost=github.com\nusername=x-access-token\npassword=%s\n' "$token"
  exit 0
fi

prev=""
explicit=""
for arg in "$@"; do
  case "$prev" in
    -R|--repo) explicit=$arg; break ;;
  esac
  case "$arg" in
    --repo=*) explicit=${arg#--repo=}; break ;;
    -R?*) explicit=${arg#-R}; break ;;
  esac
  prev=$arg
done
if [ -n "$explicit" ]; then
  repo=$(explicit_repo "$explicit") || exit 1
  [ "$repo" = personal ] && personal "$@"
fi

if [ -z "$repo" ] && [ "$1" = "api" ]; then
  # gh api: the endpoint path decides; only GraphQL falls back to the cwd.
  skip=""
  for arg in "${@:2}"; do
    if [ -n "$skip" ]; then skip=""; continue; fi
    case "$arg" in
      -X|--method|-H|--header|-f|--raw-field|-F|--field|-q|--jq|-t|--template|--input|--hostname|-p|--preview|--cache)
        skip=1; continue ;;
      -*) continue ;;
    esac
    path=$arg
    if [[ $(lower "$path") =~ ^https?://((www|api)\.)?github\.com ]]; then path=${path:${#BASH_REMATCH[0]}}; fi
    path=${path#/}
    if [[ $(lower "$path") =~ ^orgs/$org_lc(/|\?|$) ]] && [ "$method" != GET ]; then
      refuse "org-level writes are never routed to the bot or the personal login"
    elif [[ $(lower "$path") =~ ^(repositories|organizations)/ ]] && [ "$method" != GET ]; then
      # Numeric-id endpoints can name an org repository without its name.
      refuse "numeric-id endpoint writes are not routed"
    elif [[ $(lower "$path") =~ ^repos/$org_lc/[a-z0-9._-]+(/|\?|$) ]]; then
      repo=$(printf %s "$path" | cut -d/ -f3 | cut -d'?' -f1)
    elif [[ $path == *"{owner}"* || $path == *"{repo}"* || $path == *":owner"* || $path == *":repo"* ]]; then
      # gh fills placeholders from the current repository, as resolved below.
      repo=$(context_repo)
    elif [ "$(lower "$path")" = graphql ]; then
      repo=$(context_repo)
      # A mutation, or a body the shim cannot see, can target an org resource
      # by node id from anywhere.
      if [ -z "$repo" ] && { [[ " $* " == *mutation* ]] || [[ " $* " == *"=@"* ]] || [[ " $* " == *"--input"* ]]; }; then
        refuse "GraphQL mutations (or bodies read from files) outside an org checkout are not routed"
      fi
    fi
    break
  done
  [ -n "$repo" ] || personal "$@"
fi

if [ -z "$repo" ]; then
  for arg in "$@"; do
    case "$arg" in -*) continue ;; esac
    candidate=$(from_arg "$arg")
    if [ -n "$candidate" ]; then repo=$candidate; break; fi
  done
fi

[ -n "$repo" ] || repo=$(context_repo)
[ -n "$repo" ] || personal "$@"

# The permission this command needs beyond contents/PR/issues, if any.
need=""
case "$1 $2" in
  "workflow run"|"workflow enable"|"workflow disable"|"run rerun"|"run cancel"|"run delete") need=actions:write ;;
  "secret list")
    # Environment secrets are gated on the Environments permission.
    need=secrets:read
    [[ " $* " == *" --env "* || " $* " == *" -e "* || " $* " == *" --env="* ]] && need=environments:read ;;
  "variable list"|"variable get") personal "$@" ;;
  "secret "*|"variable "*) refuse "secret and variable writes stay with people" ;;
esac
if [ "$1" = api ]; then
  # GitHub shows ruleset bypass actors only to repository admins, never to an
  # App, so with read fallback enabled, ruleset reads use the personal login.
  if [ "$method" = GET ] && [ "$AGENT_IDENTITY_FALLBACK" = personal ] && [ "${AGENT_IDENTITY_PERSONAL:-read}" != deny ] && [[ " $* " == */rulesets* ]]; then
    echo "agent-identity: ruleset bypass actors are visible only to admins; this read uses the personal login." >&2
    run_unrouted "$@"
  fi
  case " $* " in
    */rulesets*) need=administration:read ;;
    */secrets*) need=secrets:read ;;
    */actions/*) [ "$method" = GET ] || need=actions:write ;;
  esac
fi

# Tokens are read-only unless the command writes.
access=""
if [ "$1" = api ]; then
  if [ "$method" != GET ] && ! { [[ " $* " == *" graphql "* ]] && [[ " $* " != *mutation* ]] && [[ " $* " != *"=@"* ]] && [[ " $* " != *" --input "* ]]; }; then
    access=--write
  fi
else
  case "$2" in
    list|view|status|diff|checks|watch|download|browse|log|clone) ;;
    *) access=--write ;;
  esac
fi

# A watch can outlive a cached token; start it with a full hour.
fresh=""
[ "$1 $2" = "run watch" ] && fresh=--fresh
if [ -n "$inherited_gh_token$inherited_github_token" ] && [ -n "$AGENT_IDENTITY_DEBUG" ]; then
  echo "agent-identity: ignoring the inherited GH_TOKEN/GITHUB_TOKEN for $org/$repo" >&2
fi
minted=$(agent-identity token --repo "$repo" $fresh $access --json) || {
  echo "agent-identity: no bot token for $org/$repo; not falling back to the personal login." >&2
  echo "agent-identity: run \`agent-identity login\` (as the human) or check the error above." >&2
  exit 1
}
if [ -n "$need" ]; then
  have=$(printf %s "$minted" | jq -r --arg p "${need%%:*}" '.permissions[$p] // "none"')
  if ! { [ "$have" = write ] || { [ "$have" = read ] && [ "${need##*:}" = read ]; }; }; then
    # Opt-in: a read the bot is not granted may use the personal login.
    # Anything that writes is always refused.
    if [ "$AGENT_IDENTITY_FALLBACK" = personal ] && [ "${AGENT_IDENTITY_PERSONAL:-read}" != deny ] && [ "${need##*:}" = read ] && [ "$method" = GET ]; then
      echo "agent-identity: the bot lacks ${need}; this read-only gh command uses the personal login." >&2
      run_unrouted "$@"
    fi
    refuse "the bot token lacks ${need}"
  fi
fi
token=$(printf %s "$minted" | jq -r .token)
[ -n "$AGENT_IDENTITY_DEBUG" ] && echo "agent-identity: gh as the bot for $org/$repo" >&2
GH_TOKEN=$token AGENT_IDENTITY_SHIM_TOKEN=1 exec "$next" "$@"
