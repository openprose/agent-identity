{
  "name": "{org}-agents",
  "url": "https://github.com/{org}",
  "description": "Identity for {org}'s AI agents. One-hour tokens are minted per agent session by the team's own broker.",
  "public": false,
  "redirect_url": "http://127.0.0.1:{port}/callback",
  "callback_urls": [
    "{broker}/v1/login/callback"
  ],
  "hook_attributes": {
    "active": false
  },
  "request_oauth_on_install": false,
  "default_events": [],
  "default_permissions": {
    "contents": "write",
    "pull_requests": "write",
    "issues": "write",
    "actions": "read",
    "checks": "read",
    "statuses": "read",
    "metadata": "read",
    "members": "read"
  }
}
